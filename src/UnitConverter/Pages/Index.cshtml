@page
@model UnitConverter.Pages.IndexModel
@using UnitConverter.Models

@{
    ViewData["Title"] = "Unit Converter";
}
@* This is something I wanted to try out to add background and rounded corners. *@
<div class="bg-dark text-light p-4 rounded border border-success">

    <h1>Unit Converter</h1>

    <div class="text-center mb-3">
        <a asp-page="/QuickConversions">Quick Conversion</a>
    </div>

    <form method="get" action="/Conversions">
        <div>
            <label for="conversionType" class="form-label">
                The Conversion Type
            </label>

            <select id="conversionType" name="Conversion.ConversionType" class="form-select">
                @foreach (var conversion in ConversionTypes.All)
                {
                    <option value="@conversion.Key">
                        @conversion.Value
                    </option>
                }
            </select>
        </div>

        <div>
            <label for="input" class="form-label mt-3">
                The Value to Convert
            </label>

            <input id="input" name="Conversion.Input" type="text" class="form-control" />
        </div>

        <button type="submit" class="btn btn-primary mt-3">
            Convert
        </button>
    </form>
</div>



