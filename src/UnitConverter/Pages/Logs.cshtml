@page
@model UnitConverter.Pages.LogsModel

@{
    ViewData["Title"] = "Logs";
}

<h1>Application Logs</h1>

<form method="get" class="row g-3 mb-4">
    <div class="col-md-4">
        <label asp-for="Search" class="form-label">Search</label>
        <input asp-for="Search" class="form-control" />
    </div>

    <div class="col-md-3">
        <label asp-for="Level" class="form-label">Log</label>
        <select asp-for="Level" class="form-select">
            <option value="">All</option>
            <option value="Information">Information</option>
            <option value="Warning">Warning</option>
            <option value="Error">Error</option>
        </select>
    </div>

    <div class="col-md-3">
        <label asp-for="ConversionType" class="form-label">Conversion</label>
        <select asp-for="ConversionType" class="form-select">
            <option value="">All</option>

            @foreach (var conversion in ConversionTypes.All)
            {
                <option value="@conversion.Key">
                    @conversion.Value
                </option>
            }
        </select>
    </div>

    <div class="col-md-2 d-flex align-items-end gap-2">
        <button type="submit" class="btn btn-primary">Search</button>

        <a asp-page="/Logs" class="btn btn-secondary">
            Clear
        </a>
    </div>
</form>

<table class="table table-striped">
    <thead>
    <tr>
        <th scope="col">Timestamp</th>
        <th scope="col">Level</th>
        <th scope="col">Message</th>
        <th scope="col">Conversion</th>
        <th scope="col">Input</th>
        <th scope="col">Result</th>
    </tr>
    </thead>

    <tbody>
    @if (Model.Entries.Count == 0)
    {
        <tr>
            <td colspan="6">
                No log entries match the selected filters.
            </td>
        </tr>
    }
    else
    {
        @foreach (var entry in Model.Entries)
        {
            <tr>
                <td>@entry.Timestamp</td>
                <td>@entry.Level</td>
                <td>@entry.Message</td>
                <td>@entry.ConversionType</td>
                <td>@entry.Input</td>
                <td>@entry.Result</td>
            </tr>
        }
    }
    </tbody>
</table>
