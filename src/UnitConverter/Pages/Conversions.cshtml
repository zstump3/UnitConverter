@page "{ConversionType=MilesToKilometers}/{Input=3.1415}"
@model UnitConverter.Pages.ConversionsModel

@if (ViewData["ErrorMessage"] is not null)
{
    <p class="text-danger">
        @ViewData["ErrorMessage"]
    </p>
}
else
{
    @* TODO Add the unit name to the end of input and output *@
    <h1>@ViewData["ConversionType"]</h1>

    <p>Input: @Model.Conversion.Input</p>

    <p>Output: @Model.Conversion.Output</p>
}
